# Supabase — required for auth, profiles, observations, comments, flags, wallets
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# IPFS — Pinata (https://app.pinata.cloud)
PINATA_API_KEY=
PINATA_SECRET_KEY=

# Stellar network: "testnet" or "public"
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Stellar NFT issuer secret key (the account that issues observation assets/NFTs)
# Generate a keypair at https://laboratory.stellar.org/#account-creator?network=test
STELLAR_ISSUER_SECRET=

# Wallet encryption key used by lib/stellar/wallet-crypto.ts
# Must be at least 32 characters and must remain stable once wallets exist.
WALLET_ENCRYPTION_KEY=
